# Anthropic (LLM + Vision)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# OpenAI (Embeddings)
OPENAI_API_KEY=your_openai_api_key_here

# Cohere (Reranking)
COHERE_API_KEY=your_cohere_api_key_here

# Qdrant (Vector DB)
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=                      # Leave empty for local Docker instance
QDRANT_COLLECTION_NAME=SEC_COMPANY_ANALYSIS

# Redis (session-scoped conversation memory)
REDIS_URL=redis://localhost:6379/0

# App settings
LOG_LEVEL=INFO
MAX_UPLOAD_SIZE_MB=50

# SEC EDGAR (required User-Agent per SEC's fair access policy — use your real name/email)
SEC_EDGAR_USER_AGENT=Your Name your.email@example.com

# LangSmith (optional — tracing fails open if unset)
LANGSMITH_TRACING=false
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=SEC_ANALYSIS
